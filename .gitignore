backend/staticfiles/

# Source textbooks (copyright) and regenerable build artifacts - see README
RAG/*.pdf
!RAG/fig*.pdf
backend/chroma_store/
backend/data/ocr/

# Study backups (participant data) - keep on another disk, never in git
backups/
backend/logs/

# Research exports contain participant identities and teacher feedback.
outputs/trace_exports_*/source_snapshot.json
outputs/trace_exports_*/*.csv
!outputs/trace_exports_*/data_dictionary.csv
outputs/trace_exports_*/*.zip

# Raw research-result archives contain identifiable student and teacher data.
/backend/file/trace/*.zip
