# TRACE Tutor backend configuration.
# Copy to backend/.env and fill in. Never commit the real .env - it is gitignored.

# ---------------------------------------------------------------- required
# Tutor generation, OCR ingestion and embeddings all use this key.
GEMINI_API_KEY=

# When may a participant switch tutor mode?
#   after_protocol  only after all four papers are submitted (default - rigorous AND lets
#                   students choose, once nothing they do can affect the primary outcomes)
#   never           fully locked controlled run
#   always          free switching; pilots and demos only
# The allocated arm is recorded permanently and the analysis compares by it regardless.
ARM_SWITCH_POLICY=after_protocol

# Papers during which the tutor is switched off server-side; an open one older than the
# TTL (hours) without a submission stops blocking, so an abandoned tab cannot lock a
# participant out for good.
NO_AI_PAPERS=pre,withdrawal
PAPER_SITTING_TTL_HOURS=4

# Required to register a teacher or researcher account. Leave empty and staff
# registration is refused outright rather than accepting any code.
STAFF_ACCESS_CODE=

# ---------------------------------------------------------------- environment
# 1 for local development: verbose error pages, permissive CORS, media served by
# Django, and a throwaway SECRET_KEY if you have not set one.
# Leave at 0 for anything anyone else can reach.
DEBUG=1

# Mandatory when DEBUG=0 - the server refuses to start without it. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated hostnames Django will answer to. Defaults to localhost.
# ALLOWED_HOSTS=lab-server.school.edu,192.168.1.50

# Serve TLS-only cookies and redirect http->https. Defaults to "on whenever DEBUG=0".
# A proctored lab server on a closed network with no TLS must set this to 0, or
# nobody will be able to log in.
# HTTPS_ONLY=0

# Set when a reverse proxy terminates TLS and forwards X-Forwarded-Proto.
# BEHIND_TLS_PROXY=1

# Let Django serve backend/media/ (profile pictures). Defaults to the value of DEBUG.
# SERVE_MEDIA=1

# Browser origins allowed to call the API and post forms. When Django serves the built
# app itself (see README, Deploying) this is simply the site's own origin.
# CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# The production build of the React app (`npm run build` in frontend/), which Django
# serves itself. Defaults to ../frontend/dist next to backend/.
# FRONTEND_DIST=/srv/trace-tutor/frontend/dist

# Verbosity of the log on stderr: DEBUG, INFO (default), WARNING or ERROR. Request
# errors and their tracebacks are logged whatever DEBUG is set to.
# LOG_LEVEL=INFO

# ---------------------------------------------------------------- database
# PostgreSQL only. Create an empty database first (createdb trace_tutor_db, or pgAdmin);
# `manage.py migrate` builds the schema. The tests create and drop test_<DB_NAME>, so the
# user needs CREATEDB.
DB_NAME=trace_tutor_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------- models
# Which provider generates tutor answers: openai, gemini, or auto (OpenAI whenever
# OPENAI_API_KEY is set, Gemini otherwise). Embeddings and OCR always use Gemini - the
# curriculum index was built with gemini-embedding-001 and stays on it.
LLM_PROVIDER=auto
OPENAI_API_KEY=
# Pin the generation model for the duration of a study.
OPENAI_MODEL=gpt-5-mini
# Tried on quota or availability errors; empty by default (see GEMINI_FALLBACK_MODELS).
OPENAI_FALLBACK_MODELS=
# Reasoning effort for GPT-5-class models (minimal, low, medium, high); leave empty for
# the model's default. Models that do not accept it are retried without it.
# OPENAI_REASONING_EFFORT=low
# Sampling temperature for whichever provider is active; falls back to GEMINI_TEMPERATURE.
# GPT-5-class models only accept their default and are retried without it.
# LLM_TEMPERATURE=0

# Pin the generation model for the duration of a study.
GEMINI_MODEL=gemini-3.6-flash

# Tried on quota or availability errors. EMPTY BY DEFAULT: a participant served by a
# different model than the rest of the cohort is a confound. Fill this in only if you
# would rather the tutor degrade to another model than fail outright.
GEMINI_FALLBACK_MODELS=

# Sampling temperature for tutor turns. 0 keeps the manipulation identical for everyone
# who asks the same question about the same code. Raise it only deliberately.
GEMINI_TEMPERATURE=0

GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMENSIONS=768

# ---------------------------------------------------------------- exam grading
# A submission is saved the instant it arrives and graded afterwards (grading compiles
# five C programs; a whole cohort submits inside the same minute).
#
# GRADING_MODE=thread   grade on background threads inside the web process (default;
#                       fine for one lab server).
# GRADING_MODE=worker   the web process only queues; run `python manage.py
#                       grade_submissions` alongside it to do the compiling. Use this
#                       when the web server has several worker processes.
GRADING_MODE=thread

# How many submissions to grade at once. Defaults to the CPU count; each submission
# already compiles up to three programs in parallel.
# GRADING_CONCURRENCY=8

# A submission still 'grading' this many minutes after it was claimed is treated as
# abandoned (a grader that died mid-compile) and requeued by the next sweep.
# GRADING_STALE_MINUTES=10

# ---------------------------------------------------------------- code sandbox
# POST /api/code/run/ executes participant-written programs. Build the runner image once:
#   docker build -f backend/tutor/sandbox.Dockerfile -t trace-tutor-runner:1 backend/tutor
#
# 'auto' picks the strongest backend available: docker (full isolation) > rlimit
# (POSIX resource caps, no filesystem or network isolation) > none.
CODE_SANDBOX=auto

# Refuse to execute when the active tier is below the minimum, rather than running
# under-protected. Defaults to "on whenever DEBUG=0".
# CODE_SANDBOX_REQUIRED=1

# The weakest tier that satisfies the requirement. 'docker' (the default) refuses to run
# student code under 'rlimit', which caps memory and processes but leaves the host
# filesystem (.env, the DB) and the network reachable. Set to 'rlimit' only on a closed,
# proctored network where you accept those gaps.
# CODE_SANDBOX_MIN_TIER=docker

# CODE_SANDBOX_IMAGE=trace-tutor-runner:1
# CODE_SANDBOX_CPUS=1.0

# Caps on the student's program, and on the compiler.
# CODE_RUN_MEMORY_MB=256
# CODE_RUN_MAX_PROCESSES=64
# CODE_COMPILE_MEMORY_MB=1024

# ---------------------------------------------------------------- tuning
# How long an identical tutor answer is reused (seconds).
TUTOR_ANSWER_CACHE_SECONDS=604800

# Override the C compiler executable. Auto-detected otherwise (gcc, clang, then ziglang).
# C_COMPILER=gcc
