# TRACE Tutor backend configuration.
# Copy to backend/.env and fill in. Never commit the real .env - it is gitignored.

# ---------------------------------------------------------------- required
# Tutor generation, OCR ingestion and embeddings all use this key.
GEMINI_API_KEY=

# Required to register a teacher or researcher account. Leave empty and staff
# registration is refused outright rather than accepting any code.
STAFF_ACCESS_CODE=

# ---------------------------------------------------------------- environment
# 1 for local development: verbose error pages, permissive CORS, media served by
# Django, and a throwaway SECRET_KEY if you have not set one.
# Leave at 0 for anything anyone else can reach.
DEBUG=1

# Mandatory when DEBUG=0 - the server refuses to start without it. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated hostnames Django will answer to. Defaults to localhost.
# ALLOWED_HOSTS=lab-server.school.edu,192.168.1.50

# Serve TLS-only cookies and redirect http->https. Defaults to "on whenever DEBUG=0".
# A proctored lab server on a closed network with no TLS must set this to 0, or
# nobody will be able to log in.
# HTTPS_ONLY=0

# Set when a reverse proxy terminates TLS and forwards X-Forwarded-Proto.
# BEHIND_TLS_PROXY=1

# Let Django serve backend/media/ (profile pictures). Defaults to the value of DEBUG.
# SERVE_MEDIA=1

# Browser origins allowed to call the API and post forms.
# CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- database
# 1 for PostgreSQL, 0 for the SQLite fallback.
USE_POSTGRES=0
DB_NAME=trace_tutor_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------- models
# Pin the generation model for the duration of a study.
GEMINI_MODEL=gemini-3.6-flash

# Tried on quota or availability errors. SET THIS EMPTY FOR AN EXPERIMENTAL RUN:
# a participant served by a different model is a confound.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite

GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMENSIONS=768

# ---------------------------------------------------------------- tuning
# How long an identical tutor answer is reused (seconds).
TUTOR_ANSWER_CACHE_SECONDS=604800

# Override the C compiler executable. Auto-detected otherwise (gcc, clang, then ziglang).
# C_COMPILER=gcc
